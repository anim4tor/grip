        ],
        "tasks": [
          {
            "task": "svg",
            "enable": true
          }
        ],
        "output": {
          "extension": ".svg",
          "type": "SOURCE_RELATIVE",
          "relativePath": ""
        }
      }
    },
    "files": [
      {
        "file": "js/app.js",
        "config": {
          "autoCompile": true,
          "customOutput": "dist\\js\\app.dist.js",
          "tasks": {
            "concat-js": {
              "enable": true
            },
            "minify-js": {
              "enable": false
            }
          }
        }
      },
      {
        "file": "scss/themes/_main.scss",
        "config": {
          "autoCompile": true,
          "customOutput": "dist\\css\\style.dist.css"
        }
      },
      {
        "file": "site/assets/css/app.scss",
        "config": {
          "customOutput": "public/assets/css/app.dist.css"
        }
      },
      {
        "file": "site/assets/js/app.js",
        "config": {
          "autoCompile": true,
          "customOutput": "public/assets/js/app.dist.js",
          "tasks": {
            "concat-js": {
              "enable": true
            }
          }
        }
      },
      {
        "file": "src/assets/css/app.scss",
        "config": {

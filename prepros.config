        }
      },
      {
        "file": "src/assets/js/app.js",
        "config": {
          "autoCompile": true,
          "customOutput": "public/assets/js/app.dist.js",
          "tasks": {
            "concat-js": {
              "enable": true
            }
          }
        }
      },
      {
        "file": "src/components/templates/App/index.js",

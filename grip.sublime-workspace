        }, 300)\n        }\n    }\n\n    close() {\n        if(this.is_open) { \n            document.documentElement.classList.remove(this.openClass);\n            document.documentElement.classList.remove('no-scroll');\n            setTimeout( () => {\n                this.card.remove()\n                this.is_open = false\n            }, 300)\n        }\n    }\n\n    initEvents() {\n        var _this = this\n        document.querySelectorAll('[open-dropdown]').forEach(function(el) {\n            el.addEventListener(\"click\", (e) => {\n                e.preventDefault()\n                _this.fetch(e)\n            })\n        })\n        document.querySelectorAll('[close-dropdown]').forEach(function(el) {\n            el.addEventListener(\"click\", e => {\n                e.preventDefault()\n                _this.close()\n            });\n        })\n    }\n\n    after() {\n\n    }\n}\n// bind modal events\nvar DROPDOWN = new Dropdown()\n\nfunction initDropdowns(container = document) {\n    DROPDOWN.init()\n}\n",
